# PaperSeal configuration — copy to `.env` and fill in. Variable NAMES only here.
# Never commit .env. Never put a seed phrase or a mainnet key anywhere in this project.

# --- Frontend (Vite exposes only VITE_* variables to the browser) ---
# Address of your deployed CertificateRegistry on Base Sepolia (0x + 40 hex chars).
VITE_CONTRACT_ADDRESS=
# Block number of the deployment transaction (speeds up event queries).
VITE_DEPLOY_BLOCK=
# Target chain. 84532 = Base Sepolia (default). 31337 = local Hardhat node for development only.
VITE_CHAIN_ID=
# Read-only JSON-RPC endpoint. Defaults to https://sepolia.base.org for 84532.
VITE_RPC_URL=
# Public URL of the deployed app, used in the pass QR code (defaults to the current page URL).
VITE_PUBLIC_APP_URL=
# Synthetic institution name shown on the pass (default: Northbridge Technical Institute).
VITE_INSTITUTION_NAME=

# --- Optional: Hardhat CLI deployment / verification (never exposed to the browser) ---
# Recommended deploy path is key-free: PaperSeal → Setup → "Deploy with MetaMask".
BASE_SEPOLIA_RPC_URL=
# Only if you choose CLI deploy: a throwaway TESTNET-ONLY key. Keep it in your local .env only.
DEPLOYER_PRIVATE_KEY=
# Optional, for `npx hardhat verify --network baseSepolia <address>`.
BASESCAN_API_KEY=
