{
  "name": "paperseal",
  "private": true,
  "version": "1.0.0",
  "description": "PaperSeal — blockchain-based educational certificate verification on Base Sepolia (HASH-IT-OUT 2026, Track 1: Digital Identity)",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint .",
    "test": "npm run test:contracts && npm run test:web",
    "test:web": "vitest run",
    "test:contracts": "hardhat test",
    "compile": "hardhat compile && node scripts/export-abi.js",
    "chain:local": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "deploy:base-sepolia": "hardhat run scripts/deploy.js --network baseSepolia"
  },
  "dependencies": {
    "ethers": "^6.17.0",
    "lucide-react": "^1.79.0",
    "motion": "^14.14.0",
    "qrcode-generator": "^2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.7.0",
    "dotenv": "^16.6.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "hardhat": "^2.29.2",
    "jsdom": "^26.1.0",
    "solc": "0.8.24",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^6.4.6",
    "vitest": "^3.2.7"
  }
}
